# Copy this file to .env. Keep PayPal values empty to use the no-charge local
# demo order flow. Never commit .env or expose the PayPal secret to the browser.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/commonthread.sqlite
# Optional hosted PostgreSQL URL. When set, this takes precedence over SQLite.
# Render provides an Internal Database URL on the database's Info page.
DATABASE_URL=
# Set true only when the selected database requires TLS.
DATABASE_SSL=false
# Set true when TLS terminates in front of the Node server (for example, a
# managed hosting proxy) so the session cookie always includes Secure.
SESSION_COOKIE_SECURE=false

# Google AI Studio API key. Without it, kit planning uses local rules and the
# assistant answers a small product-support knowledge base.
# The server sends Gemini Interactions with store=false.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# PayPal Developer sandbox REST app credentials. Both are required to show the
# real PayPal sandbox button. Never expose the secret in browser code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Shared judge/demo login. Recreated at startup; sample workspace is read-only.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@commonthread.test
DEMO_PASSWORD=CommonThreadDemo2026!

# Optional Google OpenID Connect sign-in. Register the exact callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# Optional PayPal Login with PayPal identity sign-in. Separate from checkout.
# Request only openid, profile, and email; start in sandbox.
PAYPAL_LOGIN_ENV=sandbox
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/oauth/paypal/callback

# Optional operator contact details. The contact form stores tickets in SQLite
# either way; it does not send email notifications.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_URL=
